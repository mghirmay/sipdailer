<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <EditText
        android:id="@+id/contacts_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search contacts"
        android:inputType="textNoSuggestions"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@android:color/white"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/contacts_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingEnd="28dp"
            android:clipToPadding="false" />

        <de.synitlabs.sinitphone.AlphabetIndexView
            android:id="@+id/alphabet_index"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/letter_bubble"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:textSize="32sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_letter_bubble"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
